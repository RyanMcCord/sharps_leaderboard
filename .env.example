# Copy this file to .env to run bots on your own computer. The scheduled GitHub runs use repo secrets instead.

# X API bearer token (developer.x.com -> your app -> Keys and tokens)
X_BEARER_TOKEN=

# Anthropic API key (platform.claude.com -> API Keys)
ANTHROPIC_API_KEY=

# Aurora (express configuration), signed in with a temporary IAM token. No password.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
DB_HOST=
DB_NAME=postgres

# Or a full-configuration Aurora cluster through the RDS Data API (leave DB_HOST blank)
# DB_CLUSTER_ARN=
# DB_SECRET_ARN=

# Or any Postgres you can connect to directly (leave DB_HOST blank)
# DATABASE_URL=postgresql://user:password@localhost:5432/sharps

# Claude model the bots use
CLAUDE_MODEL=claude-sonnet-5-5

# sharps-leaderboard settings (all optional; see bots/sharps_leaderboard/README.md)
# Most new posts to request per account per run (5-100). You're billed per post returned,
# and only posts newer than the last run come back, so this is a ceiling, not a cost.
MAX_POSTS_PER_ACCOUNT=100
# Backfill for an account's very first run
FIRST_RUN_POSTS=20
# Odds assumed when a tipster doesn't post odds (American format)
DEFAULT_ODDS=-110
# Re-read each pick post once after grading to catch deleted picks (one X read per post)
CHECK_DELETIONS=true
