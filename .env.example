# Copy this file to .env and fill in your keys.

# X API bearer token (developer.x.com -> your app -> Keys and tokens)
X_BEARER_TOKEN=

# Anthropic API key (console.anthropic.com) - used to read picks out of posts and images
ANTHROPIC_API_KEY=

# Optional overrides
PARSER_MODEL=claude-sonnet-5-5
DB_PATH=tracker.db
# How many recent posts to request per account per run (5-100). Each post returned costs a read.
MAX_POSTS_PER_ACCOUNT=20
# Odds assumed when a tipster doesn't post odds (American format)
DEFAULT_ODDS=-110
